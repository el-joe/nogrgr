# .env holds INFRASTRUCTURE only: what the app needs before the database is reachable
# (decision #69). Every integration and business setting lives in the database, edited in
# Admin › Integrations (payment gateways, mail, Google / Apple login, Reverb / Pusher client,
# Cloudflare, AI, Neozena, geocoding) and Admin › Settings › General / Platform (billing tax
# and invoice days, checkout limits, store edge IPv4). Enforced by
# tests/Unit/Architecture/EnvUsageTest.php.

APP_NAME=Nogrgr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://nogrgr.loc

# First entry = primary central domain (website, /admin, /affiliate). Others redirect to it.
CENTRAL_DOMAINS=nogrgr.loc,localhost,127.0.0.1
# Store sub-domains are created as {slug}.TENANT_BASE_DOMAIN at registration.
TENANT_BASE_DOMAIN=nogrgr.loc

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nogrgr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Non-delivering sinks used until Admin › Integrations › Mail / Reverb are enabled.
# Only log|array (mail) and null|log (broadcast) are accepted; real transports come from the DB.
MAIL_MAILER=log
BROADCAST_CONNECTION=null

# Reverb server process bind (php artisan reverb:start). App keys and the client host
# are set in Admin › Integrations › Reverb / Pusher.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
