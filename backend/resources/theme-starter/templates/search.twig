{% extends "layout.twig" %}
{% import "partials/macros.twig" as ui %}

{% block content %}
    <div class="container page">
        {{ ui.breadcrumbs(listing.breadcrumbs, store.home_url) }}
        <h1 class="page-title">{{ search.term ? t('search.results_for', {term: search.term}) : t('search.title') }}</h1>

        <form class="search-big" action="{{ url('search') }}" method="get" role="search">
            <label class="sr-only" for="search-page-q">{{ t('header.search_label') }}</label>
            <input id="search-page-q" type="search" name="q" value="{{ search.term }}" placeholder="{{ t('header.search_placeholder') }}" maxlength="100">
            <button class="btn" type="submit">{{ t('header.search_submit') }}</button>
        </form>

        {% if listing.products is not empty %}
            {% include "partials/listing-body.twig" with {listing: listing, empty_title: '', empty_text: ''} only %}
        {% else %}
            {{ ui.empty(search.term ? t('search.empty_title', {term: search.term}) : t('search.start_title'), t('search.empty_text'), url('categories'), t('common.browse_categories')) }}
            {% include "partials/product-rail.twig" with {title: t('search.popular'), items: search.popular} only %}
        {% endif %}
    </div>
{% endblock %}
