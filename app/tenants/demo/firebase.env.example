# Copy to firebase.env (gitignored) to switch push on for this tenant build.
# Values: Firebase console > Project settings > Your apps (client options). The app id
# differs per platform; leave everything empty to build without push (no-op).
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
